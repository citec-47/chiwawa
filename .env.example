# PostgreSQL (Neon or local PostgreSQL). Use a new, rotated password.
DATABASE_URL=

# Bootstrap administrator. Generate a bcrypt hash with:
# node -e "require('bcryptjs').hash('A-unique-long-password', 12).then(console.log)"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH='$2b$12$REPLACE_WITH_A_BCRYPT_HASH'

# Cloudinary server-side credentials. Keep API secret private and rotate any
# credentials that may have been shared outside a secure password manager.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional. Used only in production to mark the session cookie Secure.
NODE_ENV=development
